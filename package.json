{
  "name": "smart-browser",
  "version": "1.0.39",
  "description": "SmartBrowser — privacy-first desktop browser with built-in VPN, IP masking, and URL/website masking.",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node scripts/fetch-tor.js",
    "setup:tor": "node scripts/fetch-tor.js",
    "setup:deps": "npm install --no-audit --no-fund --prefix backend-node && npm install --no-audit --no-fund --prefix frontend",
    "setup": "node scripts/fetch-tor.js && npm run setup:deps",
    "start": "cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k -n backend,frontend,electron -c blue,magenta,green \"npm start --prefix backend-node\" \"npm run dev --prefix frontend\" \"wait-on tcp:5173 tcp:8080 && cross-env NODE_ENV=development electron .\"",
    "build:frontend": "npm run build --prefix frontend",
    "package": "npm run build:frontend && electron-builder",
    "package:dir": "npm run build:frontend && electron-builder --dir"
  },
  "author": "SmartBrowser",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.smartbrowser.app",
    "productName": "SmartBrowser",
    "directories": {
      "output": "dist_electron",
      "buildResources": "build"
    },
    "compression": "normal",
    "asar": true,
    "files": [
      "electron/**",
      "frontend/dist/**",
      "build/icon.png",
      "build/icon.ico",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,tests,__tests__,docs,doc,example,examples}/**",
      "!**/node_modules/*/{*.ts,*.map,.eslintrc,.npmignore,.travis.yml,.editorconfig,LICENSE,license}",
      "!**/*.{md,markdown}"
    ],
    "extraResources": [
      {
        "from": "backend-node",
        "to": "backend-node",
        "filter": [
          "**/*",
          "!node_modules/.cache/**",
          "!**/test/**",
          "!**/tests/**",
          "!**/__tests__/**",
          "!**/docs/**",
          "!**/example/**",
          "!**/examples/**",
          "!**/*.md",
          "!**/*.markdown",
          "!**/*.map",
          "!**/*.ts"
        ]
      },
      {
        "from": "tor",
        "to": "tor",
        "filter": [
          "tor/**/*",
          "data/geoip",
          "data/geoip6",
          "configs/torrc-*",
          "!tor/pluggable_transports/**",
          "!**/data-*/**",
          "!**/*.tar.gz"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "SmartBrowser-${version}-win-x64.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.17"
  }
}
