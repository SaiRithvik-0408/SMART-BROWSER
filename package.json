{
  "name": "smart-browser",
  "version": "1.0.0",
  "description": "SmartBrowser — privacy-first desktop browser with built-in VPN, IP masking, and URL/website masking.",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node scripts/fetch-tor.js",
    "setup:tor": "node scripts/fetch-tor.js",
    "setup:deps": "npm install --no-audit --no-fund --prefix backend-node && npm install --no-audit --no-fund --prefix frontend",
    "setup": "node scripts/fetch-tor.js && npm run setup:deps",
    "start": "cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k -n backend,frontend,electron -c blue,magenta,green \"npm start --prefix backend-node\" \"npm run dev --prefix frontend\" \"wait-on tcp:5173 tcp:8080 && cross-env NODE_ENV=development electron .\"",
    "build:frontend": "npm run build --prefix frontend",
    "package": "npm run build:frontend && electron-builder",
    "package:dir": "npm run build:frontend && electron-builder --dir"
  },
  "author": "SmartBrowser",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.smartbrowser.app",
    "productName": "SmartBrowser",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "electron/**",
      "backend-node/**",
      "frontend/dist/**",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}"
    ],
    "extraResources": [
      { "from": "backend-node", "to": "backend-node",
        "filter": ["**/*", "!node_modules/.cache/**"] },
      { "from": "tor", "to": "tor",
        "filter": [
          "tor/tor.exe", "tor/tor",
          "data/geoip", "data/geoip6",
          "configs/torrc-*",
          "!**/data-*/**",
          "!**/pluggable_transports/**",
          "!**/*.tar.gz"
        ]
      }
    ],
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "SmartBrowser-${version}-portable.exe"
    },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
