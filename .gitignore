# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
frontend/dist/
dist_electron/

# Ignore everything in build/ EXCEPT the committed icon assets. We use
# build/* (not build/) so the re-include rules below actually apply —
# git won't recurse into a fully-excluded directory.
build/*
!build/icon.png
!build/icon.ico
!build/icon-128.png
!build/icon-256.png
!build/icon-512.png

# Editor / OS
**/.DS_Store
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# Bundled Tor (auto-downloaded by scripts/fetch-tor.js on `npm install`)
tor/tor/
tor/data/geoip
tor/data/geoip6
tor/data-*/
tor/configs/data-*/
tor/tor-bundle.tar.gz

# Electron-builder artifacts
*.exe
*.dmg
*.AppImage
*.snap
*.deb
*.rpm
